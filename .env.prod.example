# Produktivkonfiguration – Kopie als ".env" anlegen und ausfüllen.
# Diese Datei enthält Geheimnisse und darf NICHT in die Versionsverwaltung.

# Domain, unter der die App erreichbar ist (ohne https://)
APP_DOMAIN=mithelfer.example.de

# Datenbank – Passwort erzeugen mit:  openssl rand -base64 32
DB_USER=mithelfer
DB_PASSWORD=BITTE-AENDERN
DB_NAME=mithelferboerse

# Signaturschlüssel für Anmelde-Token – erzeugen mit:  openssl rand -base64 48
JWT_SECRET=BITTE-AENDERN

# Sicherungen: Aufbewahrungsdauer in Tagen
RETENTION_DAYS=30

# --- Optional: E-Mail an die Administratoren bei Passwortanfragen ----------
# Ohne diese Angaben funktioniert alles; die Anfragen erscheinen dann nur
# in der App unter "Verwaltung".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mithelferboerse <noreply@example.de>

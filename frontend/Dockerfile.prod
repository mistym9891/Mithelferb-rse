# Baut die App und liefert sie zusammen mit Caddy aus.
# Caddy übernimmt gleichzeitig TLS und leitet /api, /auth und /socket.io an das
# Backend weiter – ein Dienst statt zwei hintereinander geschalteter Proxys.

FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=builder /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
